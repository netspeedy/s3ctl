---
// The site footer: what s3ctl is, three columns of links, and a bottom row with the copyright
// and licence on the left and the licence file and the netspeedy organisation on the right.
import { github, icons } from "../lib/icons";
import { links } from "../lib/site";
import Mark from "./Mark.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const columns = [
  {
    title: "Docs",
    items: [
      { label: "Introduction", href: `${base}/introduction/` },
      { label: "Quickstart", href: `${base}/quickstart/` },
      { label: "Installation", href: `${base}/installation/` },
      { label: "CLI reference", href: `${base}/reference/cli/` },
    ],
  },
  {
    title: "Project",
    items: [
      { label: "GitHub", href: links.repo },
      { label: "Releases", href: links.releases },
      { label: "Issues", href: links.issues },
      { label: "Examples", href: links.examples },
    ],
  },
  {
    title: "Install",
    items: [
      { label: "Homebrew tap", href: links.homebrew },
      { label: "APT repository", href: `${base}/installation/#signed-apt-repository` },
      { label: "Install script", href: `${base}/installation/#installer-script` },
      { label: "GHCR image", href: links.container },
    ],
  },
];
---

<div class="s3-site-footer not-content">
  <div class="s3-columns">
    <div class="s3-about">
      <p class="s3-name"><Mark size={22} />s3ctl</p>
      <p>A single-binary CLI for creating S3-compatible buckets and issuing bucket-scoped credentials.</p>
    </div>
    {
      columns.map(({ title, items }) => (
        <nav aria-label={title}>
          <h2>{title}</h2>
          <ul>
            {items.map(({ label, href }) => (
              <li>
                <a href={href}>{label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="s3-base">
    <p class="s3-legal">
      <Mark size={18} />
      <span>© 2026 <b>Simon Oakes</b>. Released under the MIT License.</span>
    </p>
    <div class="s3-base-links">
      <a href={`${links.repo}/blob/main/LICENSE`}>
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.scale} />
        Licence
      </a>
      <a href={links.org} aria-label="netspeedy on GitHub">
        <svg class="s3-github" viewBox="0 0 16 16" aria-hidden="true"><path d={github} /></svg>
        GitHub
      </a>
    </div>
  </div>
</div>

<style>
  .s3-site-footer {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--sl-color-hairline-shade);
    font-size: var(--sl-text-sm);
  }
  .s3-columns {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr));
    gap: 1.75rem;
  }
  .s3-name {
    display: flex;
    align-items: center;
    gap: 0.5625rem;
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
  }
  .s3-about p + p {
    max-width: 17.5rem;
    margin: 0.625rem 0 0;
    line-height: 1.55;
    color: var(--sl-color-gray-3);
  }
  h2 {
    margin: 0.125rem 0 0.625rem;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    line-height: inherit;
    letter-spacing: normal;
    color: var(--sl-color-white);
  }
  ul {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  a:hover {
    color: var(--sl-color-white);
  }
  li a {
    display: inline-block;
    padding-block: 0.1875rem;
  }

  .s3-base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem 1.25rem;
    margin-top: 2rem;
    padding: 1.125rem 0 0.5rem;
    border-top: 1px solid var(--sl-color-hairline-shade);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .s3-legal {
    --s3-mark: var(--sl-color-gray-3);
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
  }
  .s3-legal b {
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }
  .s3-base-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.125rem;
    margin-inline-start: auto;
  }
  .s3-base-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding-block: 0.25rem;
  }
  svg {
    width: 0.9375rem;
    height: 0.9375rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .s3-github {
    fill: currentColor;
    stroke: none;
  }

  @media (max-width: 40rem) {
    .s3-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .s3-about {
      grid-column: 1 / -1;
    }
    .s3-legal {
      align-items: flex-start;
    }
    .s3-legal :global(.s3-mark) {
      margin-top: 1px;
    }
    .s3-base-links {
      margin-inline-start: 0;
    }
  }
</style>
