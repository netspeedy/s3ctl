---
// The s3ctl mark. src/assets/mark.svg is written by scripts/readme/build_readme_hero.py from the
// same geometry as the favicon and the README banner, so run `make readme-hero` to change it.
// It's drawn in currentColor and takes --s3-mark here: cyan on the dark theme, deep cyan on the
// light one.
import mark from "../assets/mark.svg?raw";

interface Props {
  size?: number;
}

const { size = 26 } = Astro.props;
---

<span class="s3-mark" style={`--s3-mark-size: ${size}px`} set:html={mark} />

<style>
  .s3-mark {
    display: block;
    flex: none;
    width: var(--s3-mark-size);
    height: var(--s3-mark-size);
    color: var(--s3-mark);
  }
  .s3-mark :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
