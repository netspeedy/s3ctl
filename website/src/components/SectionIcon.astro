---
// A section's icon in a small tile of its colour.
import type { Section } from "../lib/sections";

interface Props {
  section: Section;
}

const { section } = Astro.props;
---

<span class="s3-section-icon" style={`--cc: var(--s3-${section.hue}); --cb: var(--s3-${section.hue}-bg); --cl: var(--s3-${section.hue}-line)`}>
  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={section.icon} />
</span>

<style>
  .s3-section-icon {
    display: inline-grid;
    flex: 0 0 auto;
    place-items: center;
    width: 22px;
    height: 22px;
    box-sizing: border-box;
    border: 1px solid var(--cl);
    border-radius: 6px;
    background-color: var(--cb);
    color: var(--cc);
  }
  svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.1;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
