---
import { formatDate, release } from "../lib/site";
import { currentSection } from "../lib/sections";
import SectionIcon from "./SectionIcon.astro";

// Starlight's own title id, which its skip link and table of contents point at.
const PAGE_TITLE_ID = "_top";

const { entry, sidebar } = Astro.locals.starlightRoute;

// The home page draws its own title in HomeTop.astro, with this id on its h1.
const home = Astro.url.pathname.replace(/\/$/, "") === import.meta.env.BASE_URL.replace(/\/$/, "");
const section = currentSection(sidebar);
const { title, description } = entry.data;
---

{
  !home && (
    <>
      {section && (
        <p class="s3-crumbs">
          <SectionIcon section={section} />
          <span class="s3-section">{section.label}</span>
          <span class="s3-sep" aria-hidden="true">
            /
          </span>
          <span class="s3-here">{title}</span>
        </p>
      )}
      <h1 id={PAGE_TITLE_ID}>{title}</h1>
      {description && <p class="s3-lead">{description}</p>}
      {/* The release, near the top of every page, so it's on screen at every width. The right
          column's release card only shows on wide screens. */}
      {release.tagged && (
        <p class="s3-applies">
          <span>
            Applies to <span class="s3-version">{release.version}</span>
          </span>
          <span class="s3-stable">
            <span class="s3-dot" aria-hidden="true" />
            stable{release.published && `, released ${formatDate(release.published)}`}
          </span>
          <a href={release.url}>Release notes →</a>
        </p>
      )}
    </>
  )
}

<style>
  .s3-crumbs {
    display: flex;
    align-items: center;
    gap: 0.5625rem;
    margin: 0.5rem 0 0;
    font-size: var(--sl-text-sm);
  }
  .s3-section {
    font-weight: 600;
    color: var(--s3-page);
  }
  .s3-sep {
    color: var(--sl-color-gray-3);
  }
  .s3-here {
    color: var(--sl-color-gray-2);
  }
  h1 {
    margin-top: 0.875rem;
    font-size: var(--sl-text-h1);
    line-height: 1.12;
    font-weight: 750;
    letter-spacing: -0.03em;
    color: var(--sl-color-white);
  }
  .s3-lead {
    margin: 0.875rem 0 0;
    max-width: 42rem;
    font-size: var(--sl-text-lg);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }
  .s3-applies {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.875rem;
    margin: 0.875rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .s3-version {
    font-family: var(--__sl-font-mono);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .s3-stable {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-weight: 500;
    color: var(--s3-ok);
  }
  .s3-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--s3-ok-dot);
  }
  .s3-applies a {
    font-weight: 500;
    color: var(--sl-color-text-accent);
    text-decoration: none;
  }
  .s3-applies a:hover {
    text-decoration: underline;
  }
</style>
