---
import Search from "@astrojs/starlight/components/Search.astro";
import { github, icons } from "../lib/icons";
import { tabsFor } from "../lib/sections";
import { links } from "../lib/site";
import SiteTitle from "./SiteTitle.astro";
import ThemeMenu from "./ThemeMenu.astro";
import VersionMenu from "./VersionMenu.astro";

// Each tab has its own sidebar (routeData.ts narrows it), and the tab whose groups hold the current
// page is current. The home page sits outside every tab.
const tabs = tabsFor(Astro.locals.fullSidebar).filter((tab) => tab.href);
---

<div class="s3-header">
  <div class="s3-bar">
    <div class="s3-title"><SiteTitle /></div>
    <VersionMenu />
    <div class="s3-search print:hidden"><Search /></div>
    <div class="s3-actions sl-hidden md:sl-flex print:hidden">
      <a class="s3-button" href={links.releases} title="Releases">
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.tag} />
        <span class="s3-label">Releases</span>
      </a>
      <a class="s3-button" href={links.repo} title="s3ctl on GitHub">
        <svg class="s3-github" viewBox="0 0 16 16" aria-hidden="true"><path d={github} /></svg>
        <span class="s3-label">GitHub</span>
      </a>
      <ThemeMenu />
    </div>
  </div>
  <nav class="s3-tabs print:hidden" aria-label="Sections">
    {
      tabs.map(({ label, href, current }) => (
        <a href={href} aria-current={current ? "page" : undefined}>
          {label}
        </a>
      ))
    }
  </nav>
</div>

<style>
  .s3-header {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .s3-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: var(--s3-bar);
    min-width: 0;
  }
  .s3-title {
    display: flex;
    min-width: 0;
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
  }
  .s3-search {
    display: flex;
    flex: 1 1 auto;
    justify-content: flex-end;
  }
  .s3-actions {
    align-items: center;
    gap: 0.625rem;
  }
  .s3-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    height: 2.25rem;
    padding: 0 0.75rem;
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 9px;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .s3-button:hover {
    background-color: var(--s3-hover-fill);
    color: var(--sl-color-white);
  }
  svg {
    width: 1.0625rem;
    height: 1.0625rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .s3-github {
    fill: currentColor;
    stroke: none;
  }
  .s3-tabs {
    display: flex;
    align-items: stretch;
    gap: 0.25rem;
    height: var(--s3-tabs);
    margin-inline: -0.75rem;
    overflow-x: auto;
    scrollbar-width: none;
    font-size: var(--sl-text-sm);
    font-weight: 500;
  }
  .s3-tabs a {
    display: inline-flex;
    align-items: center;
    padding: 0 0.75rem;
    border-bottom: 2px solid transparent;
    color: var(--sl-color-gray-3);
    text-decoration: none;
    white-space: nowrap;
  }
  .s3-tabs a:hover {
    color: var(--sl-color-white);
  }
  .s3-tabs a[aria-current="page"] {
    border-bottom-color: var(--sl-color-text-accent);
    color: var(--sl-color-white);
  }

  @media (max-width: 23.99rem) {
    .s3-tabs a {
      padding: 0 0.5rem;
    }
  }

  /* Pages without a sidebar, like the home page, have no mobile menu, so the theme button stays
     in the bar on phones there. */
  @media (max-width: 49.99rem) {
    :global(:root:not([data-has-sidebar])) .s3-actions {
      display: flex;
    }
    :global(:root:not([data-has-sidebar])) .s3-button {
      display: none;
    }
  }

  @media (min-width: 50rem) {
    .s3-search {
      flex: 0 1 22rem;
      justify-content: flex-start;
      margin-inline-start: 0.5rem;
    }
    /* The same height as the buttons beside it. */
    .s3-search :global(button[data-open-modal]) {
      height: 2.25rem;
    }
    .s3-actions {
      margin-inline-start: auto;
    }
  }

  /* Tablets have no room for the labels, so Releases and GitHub become icons. Their names stay
     for screen readers. */
  @media (min-width: 50rem) and (max-width: 63.99rem) {
    .s3-button {
      justify-content: center;
      width: 2.25rem;
      padding: 0;
    }
    .s3-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
