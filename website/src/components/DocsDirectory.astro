---
// Every sidebar group and its pages, for the home page. It's built from the sidebar, so it can't
// fall out of step with it.
import { directory } from "../lib/sections";

const groups = directory(Astro.locals.starlightRoute.sidebar);
---

<section class="s3-directory not-content" aria-labelledby="browse-the-docs">
  <h2 id="browse-the-docs">Browse the docs</h2>
  <p class="s3-directory-sub">From a first bucket to every flag.</p>
  <div class="s3-directory-grid">
    {
      groups.map(({ section, links }) => (
        <section>
          <h3>{section.label}</h3>
          <p>{section.blurb}</p>
          <ul>
            {links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</section>

<style>
  h2 {
    margin: 0 0 0.375rem;
    font-size: 1.375rem;
    line-height: 1.3;
    font-weight: 650;
    letter-spacing: -0.015em;
    color: var(--sl-color-white);
  }
  .s3-directory-sub {
    margin: 0 0 1.75rem;
    color: var(--sl-color-gray-3);
  }
  .s3-directory-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
  }
  .s3-directory-grid section {
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline-shade);
  }
  h3 {
    margin: 0;
    font-size: var(--sl-text-base);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .s3-directory-grid p {
    margin: 0.25rem 0 0.875rem;
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }
  ul {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: block;
    padding-block: 0.25rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  a:hover {
    color: var(--sl-color-white);
  }

  @media (max-width: 56rem) {
    .s3-directory-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
