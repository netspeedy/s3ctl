---
import Default from "@astrojs/starlight/components/PageSidebar.astro";
import { formatDate, links, release } from "../lib/site";
---

<Default />
<div class="s3-release sl-hidden lg:sl-block print:hidden">
  <h2>Latest release</h2>
  <p class="s3-version">
    <span>{release.version}</span>
    {
      release.tagged && (
        <span class="s3-stable">
          <span class="s3-dot" aria-hidden="true" />
          stable
        </span>
      )
    }
  </p>
  {release.published && <p class="s3-date">{formatDate(release.published)}</p>}
  <a href={release.url}>Release notes</a>
  <a href={links.issues}>Report an issue</a>
</div>

<style>
  .s3-release {
    box-sizing: border-box;
    /* The same width as Starlight's table of contents above it. */
    width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
    margin: 1.75rem var(--sl-sidebar-pad-x) 0;
    padding: 0.875rem;
    /* A gradient border in the banner's colours around a plain panel. */
    border: 1px solid transparent;
    border-radius: 12px;
    background:
      linear-gradient(var(--sl-color-gray-7), var(--sl-color-gray-7)) padding-box,
      var(--s3-brand-bar) border-box;
    font-size: var(--sl-text-xs);
  }
  h2 {
    margin-bottom: 0.375rem;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-gray-3);
  }
  p {
    margin: 0 0 0.375rem;
  }
  .s3-version {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .s3-stable {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    font-family: var(--__sl-font);
    font-size: var(--sl-text-2xs);
    font-weight: 500;
    color: var(--s3-ok);
  }
  .s3-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--s3-ok-dot);
  }
  .s3-date {
    color: var(--sl-color-gray-3);
  }
  a {
    display: block;
    padding-block: 0.25rem;
    color: var(--sl-color-text-accent);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  @media (min-width: 72rem) {
    .s3-release {
      max-width: calc(
        (100vw - var(--sl-sidebar-width) - 2 * var(--sl-content-pad-x) - 2 * var(--sl-sidebar-pad-x)) *
          0.25
      );
    }
  }
</style>
