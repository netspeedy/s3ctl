---
// A three-way theme switch in place of Starlight's select. It keeps Starlight's contract: the
// choice lives in localStorage under "starlight-theme" ("light", "dark", or empty for the
// system setting), and <html data-theme> holds the theme in use. Starlight's inline
// ThemeProvider script reads the same key before first paint, so pages never flash.
const options = [
  { value: "light", label: "Light theme" },
  { value: "dark", label: "Dark theme" },
  { value: "auto", label: "Match system theme" },
];
---

<s3ctl-theme-switch class="s3-theme" role="group" aria-label="Colour theme">
  {
    options.map(({ value, label }) => (
      <button type="button" data-value={value} aria-pressed="false" aria-label={label} title={label}>
        {value === "light" && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
          </svg>
        )}
        {value === "dark" && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" />
          </svg>
        )}
        {value === "auto" && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="4" width="18" height="12" rx="2" />
            <path d="M8 20h8M12 16v4" />
          </svg>
        )}
      </button>
    ))
  }
</s3ctl-theme-switch>

{/* Inlined so the pressed state is right on first paint. */}
<script is:inline>
  (() => {
    let stored = null;
    try {
      stored = localStorage.getItem("starlight-theme");
    } catch {}
    const value = stored === "light" || stored === "dark" ? stored : "auto";
    document.querySelectorAll("s3ctl-theme-switch button").forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.value === value));
    });
  })();
</script>

<script>
  type Theme = "auto" | "dark" | "light";

  const storageKey = "starlight-theme";
  const parseTheme = (value: unknown): Theme =>
    value === "dark" || value === "light" ? value : "auto";

  function loadTheme(): Theme {
    try {
      return parseTheme(localStorage.getItem(storageKey));
    } catch {
      return "auto";
    }
  }

  const systemTheme = () =>
    matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";

  function applyTheme(theme: Theme): void {
    document.documentElement.dataset.theme = theme === "auto" ? systemTheme() : theme;
    try {
      localStorage.setItem(storageKey, theme === "auto" ? "" : theme);
    } catch {
      // Private windows can refuse storage; the theme still applies for this page.
    }
    document.querySelectorAll<HTMLButtonElement>("s3ctl-theme-switch button").forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.value === theme));
    });
  }

  matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => {
    if (loadTheme() === "auto") applyTheme("auto");
  });

  class ThemeSwitch extends HTMLElement {
    connectedCallback() {
      this.addEventListener("click", (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>("button[data-value]");
        if (button) applyTheme(parseTheme(button.dataset.value));
      });
    }
  }

  customElements.define("s3ctl-theme-switch", ThemeSwitch);
</script>

<style>
  .s3-theme {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 10px;
  }
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }
  button:hover {
    color: var(--sl-color-white);
  }
  button[aria-pressed="true"] {
    background-color: var(--s3-current-bg);
    color: var(--s3-current-ink);
  }
  svg {
    width: 1.0625rem;
    height: 1.0625rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (max-width: 49.99em) {
    button {
      height: 2.75rem;
    }
  }
</style>
