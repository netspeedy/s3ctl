---
// The version pill in the header. It opens a list of every docs line with its newest release, the
// line being read ticked and the latest marked, then that line's release notes and every release.
// Choosing a line opens the same page in it when the page exists there, or the line's first page
// when it doesn't. An archived line only knows itself when it's built, so it fetches the list from
// the site root when it loads.
import { icons } from "../lib/icons";
import { docs, links, siteRoot } from "../lib/site";

const current = docs.versions.find((version) => version.version === docs.current)!;
---

<s3ctl-version-menu
  class="s3-version-menu"
  data-archived={docs.archived ? "" : undefined}
  data-current={docs.current}
  data-base={current.url}
  data-root={siteRoot}
>
  <button
    class:list={["s3-version", { archived: docs.archived }]}
    type="button"
    title="Documentation version"
    aria-expanded="false"
    aria-controls="s3-versions"
  >
    <span class="s3-dot" aria-hidden="true"></span>
    {docs.current}
    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.chevron} />
  </button>
  <div id="s3-versions" class="s3-versions" hidden>
    <p id="s3-versions-title">Documentation version</p>
    <ul aria-labelledby="s3-versions-title">
      {
        docs.versions.map(({ version, release, url, latest }) => (
          <li>
            <a href={url} data-version={version} aria-current={version === docs.current ? "true" : undefined}>
              {release ? (
                <>
                  <span class="s3-line">{version}</span>
                  <span class="s3-release">{release}</span>
                  <span class="s3-latest">{latest && "Latest"}</span>
                </>
              ) : (
                <span class="s3-word">The latest docs</span>
              )}
              <svg class="s3-tick" viewBox="0 0 24 24" aria-hidden="true" set:html={icons.check} />
            </a>
          </li>
        ))
      }
    </ul>
    <hr />
    <a class="s3-out" href={current.notes}>
      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.tag} />
      Release notes for {current.release}
      <svg class="s3-external" viewBox="0 0 24 24" aria-hidden="true" set:html={icons.external} />
    </a>
    <a class="s3-out" href={links.releases}>
      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.clock} />
      All releases
      <svg class="s3-external" viewBox="0 0 24 24" aria-hidden="true" set:html={icons.external} />
    </a>
  </div>
</s3ctl-version-menu>

<script>
  import { loadVersions, samePageIn } from "../lib/versions";

  // A disclosure of links: the button opens and closes it, and Escape, a click outside or moving
  // focus elsewhere closes it.
  class VersionMenu extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>(".s3-version")!;
      const panel = this.querySelector<HTMLElement>(".s3-versions")!;
      const list = panel.querySelector("ul")!;
      const { base = "", root = "/", current } = this.dataset;

      const close = (refocus: boolean) => {
        if (panel.hidden) return;
        panel.hidden = true;
        button.setAttribute("aria-expanded", "false");
        if (refocus) button.focus();
      };
      button.addEventListener("click", () => {
        panel.hidden = !panel.hidden;
        button.setAttribute("aria-expanded", String(!panel.hidden));
      });
      this.addEventListener("keydown", (event) => {
        if (event.key === "Escape") close(true);
      });
      document.addEventListener("pointerdown", (event) => {
        if (!this.contains(event.target as Node)) close(false);
      });
      document.addEventListener("focusin", (event) => {
        if (!this.contains(event.target as Node)) close(false);
      });

      list.addEventListener("click", async (event) => {
        const link = (event.target as Element).closest<HTMLAnchorElement>("a[data-version]");
        if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        location.href = await samePageIn(link.getAttribute("href")!, base);
      });

      if (this.dataset.archived === undefined) return;
      // Rows are copies of this line's own row, which keeps the styles' scope attributes.
      loadVersions(root).then((versions) => {
        const template = list.querySelector(".s3-line")?.closest("li");
        if (!versions || !template) return;
        list.replaceChildren(
          ...versions.map(({ version, release, url, latest }) => {
            const item = template.cloneNode(true) as HTMLLIElement;
            const link = item.querySelector("a")!;
            link.href = version === current ? base : url;
            link.dataset.version = version;
            if (version === current) link.setAttribute("aria-current", "true");
            else link.removeAttribute("aria-current");
            item.querySelector(".s3-line")!.textContent = version;
            item.querySelector(".s3-release")!.textContent = release;
            item.querySelector(".s3-latest")!.textContent = latest ? "Latest" : "";
            return item;
          }),
        );
      });
    }
  }

  customElements.define("s3ctl-version-menu", VersionMenu);
</script>

<style>
  .s3-version-menu {
    position: relative;
    display: flex;
    flex: none;
  }
  .s3-version {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 1.5rem;
    padding: 0 0.4375rem 0 0.5625rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: transparent;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }
  .s3-version:hover {
    border-color: var(--sl-color-gray-4);
    color: var(--sl-color-white);
  }
  .s3-version[aria-expanded="true"] {
    border-color: transparent;
    background-color: var(--s3-current-bg);
    color: var(--s3-current-ink);
  }
  .s3-version.archived {
    border-color: var(--s3-c3-line);
    color: var(--s3-c3-ink);
  }
  .s3-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--s3-ok-dot);
  }
  .archived .s3-dot {
    background-color: var(--s3-c3);
  }
  .s3-version svg {
    width: 0.75rem;
    height: 0.75rem;
    stroke-width: 2.2;
  }
  svg {
    width: 0.9375rem;
    height: 0.9375rem;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .s3-versions {
    position: absolute;
    inset-inline-start: 0;
    top: calc(100% + 0.5rem);
    z-index: 10;
    width: 18rem;
    padding: 6px;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    background-color: var(--s3-menu-bg);
    box-shadow: var(--s3-menu-shadow);
    font-size: var(--sl-text-sm);
  }
  #s3-versions-title {
    margin: 0;
    padding: 0.5rem 0.625rem 0.375rem;
    font-size: var(--sl-text-xs);
    font-weight: 500;
    color: var(--sl-color-gray-3);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Every row has the same columns, so the lines and releases line up and the Latest badge and the
     tick each keep their own slot on the right. */
  li a {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr) auto 1rem;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.625rem;
    border-radius: 8px;
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  li a:hover,
  li a:focus-visible {
    background-color: var(--s3-hover-fill);
  }
  li a[aria-current="true"] {
    background-color: var(--s3-hover-fill);
  }
  .s3-line {
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .s3-release {
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
  }
  .s3-word {
    grid-column: 1 / 4;
    color: var(--sl-color-white);
  }
  .s3-latest:not(:empty) {
    padding: 0.0625rem 0.4375rem;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--s3-ok) 14%, transparent);
    font-size: var(--sl-text-2xs);
    font-weight: 600;
    color: var(--s3-ok);
  }
  .s3-tick {
    width: 1rem;
    height: 1rem;
    stroke-width: 2;
    color: var(--sl-color-text-accent);
    visibility: hidden;
  }
  [aria-current="true"] .s3-tick {
    visibility: visible;
  }
  hr {
    height: 1px;
    margin: 0.375rem 0.25rem;
    border: 0;
    background-color: var(--sl-color-hairline-shade);
  }
  .s3-out {
    display: flex;
    align-items: center;
    gap: 0.5625rem;
    padding: 0.4375rem 0.625rem;
    border-radius: 8px;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .s3-out:hover,
  .s3-out:focus-visible {
    background-color: var(--s3-hover-fill);
    color: var(--sl-color-white);
  }
  .s3-external {
    width: 0.75rem;
    height: 0.75rem;
    margin-inline-start: auto;
    color: var(--sl-color-gray-3);
  }

  /* On phones the list spans the screen under the bar, wherever the pill sits. */
  @media (max-width: 49.99rem) {
    .s3-version-menu {
      position: static;
    }
    .s3-versions {
      position: fixed;
      top: calc(var(--s3-bar) - 0.25rem);
      inset-inline: 1rem;
      width: auto;
    }
  }
</style>
